# CLOUD_ENV — copiar a .env (nunca subir a Git)

# Backend
CLOUD_HOST=0.0.0.0
CLOUD_PORT=8002
CLOUD_API_TOKEN=TU_TOKEN_FUERTE_AQUI
CLOUD_MODE=FREE_CLOUD
ALLOW_PAID=
INFERENCE_URL=https://TU_SPACE.hf.space

# Fish Audio (opcional, requiere saldo; sin él se usa TTS remoto gratuito)
FISH_AUDIO_API_KEY=
FISH_AUDIO_REFERENCE_ID=

# Cuotas gratuitas
CLOUD_MAX_UPLOAD_MB=30
CLOUD_MAX_JOB_SECONDS=1800
CLOUD_MAX_DAILY_JOBS=10
CLOUD_MAX_VIDEO_MB=200

# Almacenamiento (opcional S3 gratis; sin esto se usa disco del contenedor)
CLOUD_DATA_DIR=cloud/data
CLOUD_STORAGE_DIR=cloud/storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
